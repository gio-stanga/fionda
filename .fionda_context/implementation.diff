diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 75b62129a..d4c98f907 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5313,4 +5313,105 @@ ggml_backend_t ggml_backend_cuda_init(int device) {
     return cuda_backend;
 }
 
+// fionda VRAM double buffer API
+
+int ggml_backend_cuda_fionda_vram_alloc(void ** out_ptr, size_t size, int device) {
+    ggml_cuda_set_device(device);
+    cudaError_t err = cudaMalloc(out_ptr, size);
+    if (err != cudaSuccess) {
+        GGML_LOG_ERROR("%s: cudaMalloc %.2f MiB on device %d failed: %s\n",
+                __func__, size / 1024.0 / 1024.0, device, cudaGetErrorString(err));
+    }
+    return (int)err;
+}
+
+void ggml_backend_cuda_fionda_vram_free(void * ptr) {
+    if (ptr) {
+        CUDA_CHECK(cudaFree(ptr));
+    }
+}
+
+int ggml_backend_cuda_fionda_stream_create(void ** out_stream, int device) {
+    ggml_cuda_set_device(device);
+    cudaError_t err = cudaStreamCreateWithFlags(
+        reinterpret_cast<cudaStream_t *>(out_stream),
+        cudaStreamNonBlocking);
+    if (err != cudaSuccess) {
+        GGML_LOG_ERROR("%s: cudaStreamCreateWithFlags failed: %s\n",
+                __func__, cudaGetErrorString(err));
+    }
+    return (int)err;
+}
+
+void ggml_backend_cuda_fionda_stream_destroy(void * stream) {
+    if (stream) {
+        CUDA_CHECK(cudaStreamDestroy(reinterpret_cast<cudaStream_t>(stream)));
+    }
+}
+
+int ggml_backend_cuda_fionda_event_create(void ** out_event, int device) {
+    ggml_cuda_set_device(device);
+    cudaError_t err = cudaEventCreateWithFlags(
+        reinterpret_cast<cudaEvent_t *>(out_event),
+        cudaEventDisableTiming);
+    if (err != cudaSuccess) {
+        GGML_LOG_ERROR("%s: cudaEventCreateWithFlags failed: %s\n",
+                __func__, cudaGetErrorString(err));
+    }
+    return (int)err;
+}
+
+void ggml_backend_cuda_fionda_event_destroy(void * event) {
+    if (event) {
+        CUDA_CHECK(cudaEventDestroy(reinterpret_cast<cudaEvent_t>(event)));
+    }
+}
+
+void ggml_backend_cuda_fionda_memcpy_async(void * dst, const void * src, size_t size, void * stream) {
+    CUDA_CHECK(cudaMemcpyAsync(dst, src, size, cudaMemcpyHostToDevice, reinterpret_cast<cudaStream_t>(stream)));
+}
+
+void ggml_backend_cuda_fionda_event_record(void * event, void * stream) {
+    CUDA_CHECK(cudaEventRecord(reinterpret_cast<cudaEvent_t>(event), reinterpret_cast<cudaStream_t>(stream)));
+}
+
+void ggml_backend_cuda_fionda_compute_wait_event(ggml_backend_t backend, void * event) {
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *)backend->context;
+    CUDA_CHECK(cudaStreamWaitEvent(ctx->stream(), reinterpret_cast<cudaEvent_t>(event), 0));
+}
+
+void ggml_backend_cuda_fionda_compute_event_record(ggml_backend_t backend, void * event) {
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *)backend->context;
+    CUDA_CHECK(cudaEventRecord(reinterpret_cast<cudaEvent_t>(event), ctx->stream()));
+}
+
+void ggml_backend_cuda_fionda_stream_wait_event(void * stream, void * event) {
+    CUDA_CHECK(cudaStreamWaitEvent(reinterpret_cast<cudaStream_t>(stream), reinterpret_cast<cudaEvent_t>(event), 0));
+}
+
+int ggml_backend_cuda_fionda_event_create_timing(void ** out_event, int device) {
+    ggml_cuda_set_device(device);
+    cudaError_t err = cudaEventCreate(reinterpret_cast<cudaEvent_t *>(out_event));
+    if (err != cudaSuccess) {
+        GGML_LOG_ERROR("%s: cudaEventCreate failed: %s\n",
+                __func__, cudaGetErrorString(err));
+    }
+    return (int)err;
+}
+
+float ggml_backend_cuda_fionda_event_elapsed_ms(void * start, void * end) {
+    float ms = 0.0f;
+    cudaError_t err = cudaEventElapsedTime(&ms,
+        reinterpret_cast<cudaEvent_t>(start),
+        reinterpret_cast<cudaEvent_t>(end));
+    if (err != cudaSuccess) {
+        return -1.0f;
+    }
+    return ms;
+}
+
+void ggml_backend_cuda_fionda_synchronize_device(void) {
+    CUDA_CHECK(cudaDeviceSynchronize());
+}
+
 GGML_BACKEND_DL_IMPL(ggml_backend_cuda_reg)
